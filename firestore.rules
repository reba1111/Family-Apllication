rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────
    match /users/{uid} {
      // Only the authenticated user can read/write their own document.
      // Their partner can read it (for the partner tab).
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        resource.data.partnerId == request.auth.uid
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Couples ──────────────────────────────────────────────────
    match /couples/{coupleId} {
      // Any authenticated user can read (needed for code lookup).
      allow read: if request.auth != null;

      // Create: any authenticated user can create a couple doc.
      allow create: if request.auth != null;

      // Update: user1 or user2 can update.
      allow update: if request.auth != null && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );

      // ── Lessons ─────────────────────────────────────────────
      match /lessons/{lessonId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId
        );
      }

      // ── Tasks ───────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId
        );
      }

      // ── Quiz ────────────────────────────────────────────────
      match /quiz/{quizId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId
        );
      }

      // ── Family ──────────────────────────────────────────────
      match /family/{memberId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId
        );
      }
    }
  }
}
